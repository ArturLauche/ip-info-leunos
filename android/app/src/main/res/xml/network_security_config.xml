<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system trust anchors only. No cleartext, no user-installed CAs, no debug overrides. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
