    <string name="install_confirm_message">The verified update will replace this app and IP Info will restart. Your settings are kept.</string>
    <string name="install_permission_title">Allow installing updates?</string>
    <string name="install_permission_message">Android requires your permission before an app can install packages. IP Info uses it only to install its own verified updates downloaded from its GitHub releases. You’ll be taken to Android’s “Install unknown apps” screen.</string>
    <string name="metered_confirm_title">Download on mobile data?</string>
    <string name="metered_confirm_message">Updates (a few megabytes) will also be downloaded automatically on metered connections, which may use your data plan.</string>
    <string name="clear_data_title">Clear website data?</string>
    <string name="clear_data_message">This removes cookies and local storage saved by the IP Info website in this app, such as your theme and language choice.</string>
