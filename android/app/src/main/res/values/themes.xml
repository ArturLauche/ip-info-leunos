<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.IPInfo" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_muted</item>
        <item name="colorOnPrimaryContainer">@color/brand_foreground</item>
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="colorOnSecondary">@color/brand_on_primary</item>
        <item name="colorSecondaryContainer">@color/brand_muted</item>
        <item name="colorOnSecondaryContainer">@color/brand_foreground</item>
        <item name="colorTertiary">@color/brand_primary</item>
        <item name="colorOnTertiary">@color/brand_on_primary</item>
        <item name="android:colorBackground">@color/brand_background</item>
        <item name="colorSurface">@color/brand_background</item>
        <item name="colorOnSurface">@color/brand_foreground</item>
        <item name="colorSurfaceVariant">@color/brand_muted</item>
        <item name="colorOnSurfaceVariant">@color/brand_muted_foreground</item>
        <item name="colorSurfaceContainerLowest">@color/brand_background</item>
        <item name="colorSurfaceContainerLow">@color/brand_background</item>
        <item name="colorSurfaceContainer">@color/brand_card</item>
        <item name="colorSurfaceContainerHigh">@color/brand_card</item>
        <item name="colorSurfaceContainerHighest">@color/brand_muted</item>
        <item name="colorOutline">@color/brand_muted_foreground</item>
        <item name="colorOutlineVariant">@color/brand_border</item>
        <item name="colorError">@color/brand_destructive</item>
        <item name="android:windowBackground">@color/brand_background</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- Shown by the system splash screen; MainActivity switches to Theme.IPInfo afterwards. -->
    <style name="Theme.IPInfo.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.IPInfo</item>
    </style>
</resources>
