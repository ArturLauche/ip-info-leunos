<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Website and GitHub update checks. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Connectivity state, link properties and Wi-Fi details of the connected network. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!--
        Runtime permission, requested only when the user asks for the Wi-Fi name. Android reveals the
        SSID/BSSID of the connected network only with precise location (and the location setting on).
        COARSE must be declared next to FINE so the Android 12+ dialog can offer the precise/approximate
        choice. NEARBY_WIFI_DEVICES is intentionally not declared: no API used here is gated by it and it
        does not unlock SSID access.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Runtime permission on Android 13+, requested only when the user enables update notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Direct-APK self-update through PackageInstaller; the user must allow "Install unknown apps". -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Lets Android 12+ skip the confirmation for self-updates when its documented conditions are met. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <application
        android:name=".IpInfoApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IPInfo"
        android:usesCleartextTraffic="false"
        tools:targetApi="tiramisu">

        <!-- WebView: keep Safe Browsing on, and opt out of WebView usage metrics. -->
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="true" />
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode|density|navigation|fontScale"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.IPInfo.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                Links to the website may be opened in the app (user opt-in under "Open by default"); MainActivity
                re-validates every URL. Not auto-verified: that would need a Digital Asset Links file on the website.
            -->
            <intent-filter tools:ignore="AppLinkWarning">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="ip-info.leunos.com"
                    android:scheme="https" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".diagnostics.NetworkDiagnosticsActivity"
            android:exported="false"
            android:label="@string/diag_title"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".settings.AboutActivity"
            android:exported="false"
            android:label="@string/about_title"
            android:parentActivityName=".MainActivity" />

        <!-- Result of PackageInstaller sessions; only the system delivers to it. -->
        <receiver
            android:name=".updates.InstallResultReceiver"
            android:exported="false" />
        <receiver
            android:name=".updates.PackageReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
